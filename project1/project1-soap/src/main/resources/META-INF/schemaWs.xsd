<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://exame.ti/soap"
           targetNamespace="https://exame.ti/soap"
           elementFormDefault="qualified">

    <xs:element name="getPetsByOwnerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ownerNif" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getPetsByOwnerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pet" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="name" type="xs:string"/>
                            <xs:element name="species" type="xs:string"/>
                            <xs:element name="age" type="xs:int"/>
                            <xs:element name="ownerNif" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>